{
  "name": "学习监督",
  "id": "learning-supervisor",
  "manifestVersion": 1,
  "version": "1.0.0",
  "minSupVersion": "15.0.0",
  "description": "将 Super Productivity 任务同步到学习监督后端，接收告警通知",
  "author": "Supervised Learning",
  "homepage": "https://github.com/jingui020306-del/supervised-learning",
  "icon": "school",
  "permissions": ["tasks:read", "notifications"],
  "hooks": ["taskCreated", "taskComplete", "currentTaskChange", "finishDay", "anyTaskUpdate"],
  "sidePanel": true,
  "jsonSchemaCfg": {
    "type": "object",
    "properties": {
      "backendUrl": {
        "type": "string",
        "default": "http://localhost:3001",
        "description": "学习监督后端地址"
      },
      "apiToken": {
        "type": "string",
        "description": "API 认证 Token"
      },
      "syncInterval": {
        "type": "number",
        "default": 60,
        "description": "同步间隔(秒)"
      }
    },
    "required": ["backendUrl", "apiToken"]
  }
}
