<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>周报 · Trackly</title>
  <link rel="stylesheet" href="/static/design-system.css">
  <style>
    .day-row {
      display: flex; align-items: center; gap: var(--s-3);
      padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--border);
    }
    .day-label { width: 36px; text-align: center; flex-shrink: 0; }
    .day-label .dow { font-size: var(--fs-xs); font-weight: 600; }
    .day-label .date { font-size: .6rem; color: var(--text-3); }
    .day-bar-wrap { flex: 1; height: 28px; background: var(--subtle); border-radius: var(--r); overflow: hidden; }
    .day-bar-fill { height: 100%; border-radius: var(--r); transition: width .5s var(--ease); min-width: 4px; }
    .day-bar-fill.good { background: var(--brand); }
    .day-bar-fill.ok { background: var(--amber); }
    .day-bar-fill.empty { background: var(--border); }
    .day-stat { width: 52px; text-align: right; flex-shrink: 0; }
    .day-stat .min { font-weight: 700; font-size: var(--fs-sm); }
    .day-stat .sess { font-size: var(--fs-xs); color: var(--text-3); }
    .summary-row {
      display: flex; justify-content: center; gap: var(--s-5);
      padding: var(--s-3) var(--s-4); text-align: center;
      background: var(--surface); border-radius: var(--r); margin: var(--s-3) var(--s-4);
      border: 1px solid var(--border);
    }
    .summary-row .val { font-size: 1.15rem; font-weight: 700; }
    .summary-row .lbl { font-size: var(--fs-xs); color: var(--text-2); }
  </style>
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <a href="/dashboard">← 返回</a>
      <h1>周报</h1>
      <span></span>
    </header>

    <nav class="nav-pills" style="margin:var(--s-3) var(--s-4);">
      <a class="nav-pill" href="/dashboard">今日</a>
      <a class="nav-pill active" href="/dashboard/weekly">周报</a>
      <a class="nav-pill" href="/dashboard/calendar">日历</a>
      <a class="nav-pill" href="/dashboard/plans">计划</a>
      <a class="nav-pill" href="/dashboard/apps">App</a>
      <a class="nav-pill" href="/dashboard/notify">推送</a>
      <a class="nav-pill" href="/dashboard/settings">设置</a>
    </nav>

    <div class="summary-row" id="summary">
      <div><div class="val" id="sum-total">-</div><div class="lbl">总分钟</div></div>
      <div><div class="val" id="sum-sessions">-</div><div class="lbl">总次数</div></div>
      <div><div class="val" id="sum-avg">-</div><div class="lbl">日均</div></div>
    </div>

    <div id="day-list"></div>
  </div>

  <script>
    var UID = new URLSearchParams(location.search).get("userId") || "student-1";
    var DOW = ["日","一","二","三","四","五","六"];

    fetch("/api/v1/dashboard/weekly?userId=" + UID)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var days = (data.days || []).reverse();
        var totalMin = 0, totalSess = 0, maxMin = 1;
        days.forEach(function(d) {
          totalMin += d.totalMin || 0;
          totalSess += d.totalSessions || 0;
          if (d.totalMin > maxMin) maxMin = d.totalMin;
        });

        document.getElementById("sum-total").textContent = totalMin;
        document.getElementById("sum-sessions").textContent = totalSess;
        document.getElementById("sum-avg").textContent = days.length ? Math.round(totalMin / days.length) : 0;

        var html = "";
        days.forEach(function(d) {
          var pct = maxMin > 0 ? Math.round((d.totalMin / maxMin) * 100) : 0;
          var cls = d.totalMin >= 60 ? "good" : d.totalMin >= 20 ? "ok" : "empty";
          html += '<div class="day-row">'
            + '<div class="day-label"><div class="dow">周' + DOW[d.dayOfWeek] + '</div><div class="date">' + (d.date||"").slice(5) + '</div></div>'
            + '<div class="day-bar-wrap"><div class="day-bar-fill ' + cls + '" style="width:' + Math.max(pct, 3) + '%"></div></div>'
            + '<div class="day-stat"><div class="min">' + (d.totalMin||0) + 'm</div><div class="sess">' + (d.totalSessions||0) + '次</div></div>'
            + '</div>';
        });

        document.getElementById("day-list").innerHTML = html || '<div class="empty-state"><p>本周暂无数据</p></div>';
      });
  </script>
</body>
</html>
