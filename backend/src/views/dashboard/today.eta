<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Trackly</title>
  <link rel="stylesheet" href="/static/design-system.css">
  <style>
    #tree-wrap { position: relative; margin-bottom: var(--s-3); border-radius: var(--r-lg); overflow: hidden; background: var(--surface); border: 1px solid var(--border); }
    #tree-container { width: 100%; height: 130px; }
    #tree-container canvas { display: block; width: 100%; height: 100%; }
    #tree-overlay {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      pointer-events: none; font-size: 4rem; opacity: 0; transition: opacity .6s;
    }
    #tree-overlay.show { opacity: 1; }
    .tree-stats {
      display: flex; justify-content: center; gap: var(--s-6);
      text-align: center; padding: 0 0 var(--s-3); font-size: var(--fs-xs);
    }
    .tree-stats .alive { color: var(--brand); }
    .tree-stats .dead  { color: var(--red); }
    .tree-stats .num { font-size: var(--fs-xl); font-weight: 700; display: block; }
  </style>
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <span style="font-size:var(--fs-xs);color:var(--text-3);"><%= it.date %></span>
      <h1>Trackly</h1>
      <span style="font-size:var(--fs-xs);color:var(--brand);font-weight:600;">● 在线</span>
    </header>

    <nav class="nav-pills">
      <a class="nav-pill active" href="/dashboard">今日</a>
      <a class="nav-pill" href="/dashboard/weekly">周报</a>
      <a class="nav-pill" href="/dashboard/calendar">日历</a>
      <a class="nav-pill" href="/dashboard/plans">计划</a>
      <a class="nav-pill" href="/dashboard/apps">App</a>
      <a class="nav-pill" href="/dashboard/settings">设置</a>
    </nav>

    <!-- Tree with death overlay -->
    <div id="tree-wrap">
      <div id="tree-container"></div>
      <div id="tree-overlay">🥀</div>
    </div>

    <!-- Tree stats: 3 tiers -->
    <div class="tree-stats">
      <div class="alive"><span class="num" id="grown-count">-</span>养大</div>
      <div class="alive" style="color:var(--amber);"><span class="num" id="alive-count">-</span>成活</div>
      <div class="dead"><span class="num" id="dead-count">-</span>枯萎</div>
    </div>

    <div style="text-align:center;font-size:var(--fs-xs);color:var(--text-3);margin-bottom:var(--s-4);">
      <%= it.summary.totalActual %> / <%= it.summary.totalPlanned %> 分钟 · <%= it.plans.length %> 项计划
    </div>

    <% if (it.plans.length === 0) { %>
      <div class="empty-state">
        <p>今天还没有学习计划</p>
        <p style="font-size:var(--fs-xs);">上传 Excel 或在计划页面创建</p>
      </div>
    <% } %>

    <% it.plans.forEach(function(plan) { %>
      <% const cls = plan.progress >= 90 ? 'high' : plan.progress >= 50 ? 'medium' : 'low'; %>
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
          <div>
            <div style="font-weight:600;"><%= plan.title %></div>
            <div style="font-size:var(--fs-xs);color:var(--text-3);"><%= plan.startTime %>-<%= plan.endTime %><% if (plan.appName) { %> · <%= plan.appName %><% } %></div>
          </div>
          <span style="font-weight:700;font-size:var(--fs-sm);color:var(--<%= cls === 'high' ? 'brand' : cls === 'medium' ? 'amber' : 'red' %>);"><%= plan.progress %>%</span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill <%= cls %>" style="width:<%= Math.min(plan.progress, 100) %>%"></div>
        </div>
        <div class="progress-label">
          <span><%= plan.actualMin %> 分钟</span>
          <span>目标 <%= plan.plannedMin %> 分钟</span>
        </div>
      </div>
    <% }) %>
  </div>

  <script src="/static/tree.min.js"></script>
  <script>
    (function() {
      var pct = <%= it.summary.completionRate %>;
      // Map: 0%→depth3(seedling), 50%→depth7(half), 100%→depth12(full)
      var depth = pct === 0 ? 3 : Math.max(3, Math.round(pct / 100 * 9 + 3));
      // Dead tree: below 50% completion after plans exist
      var isDead = <%= it.summary.totalPlanned %> > 0 && pct < 50;

      var opts = {
        container: document.getElementById("tree-container"),
        depth: depth,
        growthSpeed: 40,
        treeScale: 0.5,
        seed: <%= it.date ? it.date.replace(/-/g, '') : '20260515' %>,
      };
      if (isDead) {
        opts.growthSpeed = 0;
        opts.treeScale = 0.25;
        opts.gradientStart = "#d4d4d4";
        opts.gradientEnd = "#a3a3a3";
      }
      new TreePlugin(opts);

      // Show wither overlay
      if (isDead) {
        document.getElementById("tree-overlay").classList.add("show");
      }
    })();

    // Load weekly tree stats (3 tiers)
    (function() {
      var uid = new URLSearchParams(location.search).get("userId") || "stu-1";
      fetch("/api/v1/dashboard/weekly?userId=" + uid)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var grown = 0, alive = 0, dead = 0;
          if (data.days) {
            data.days.forEach(function(d) {
              // Only count days that had plans
              var total = d.totalMin + d.matchedMin;
              if (total < 10) return; // skip days with negligible activity
              // Use matchedMin / totalMin ratio as approximate completion
              // Actually use totalSessions as indicator
              if (d.totalMin >= 60) grown++;      // 60+ min = fully grown
              else if (d.totalMin >= 20) alive++;  // 20-59 min = alive
              else dead++;                         // <20 min = dead
            });
          }
          document.getElementById("grown-count").textContent = grown || "0";
          document.getElementById("alive-count").textContent = alive || "0";
          document.getElementById("dead-count").textContent = dead || "0";
        });
    })();

    // Auto-refresh at midnight
    var now = new Date();
    var msToMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1).getTime() - now.getTime();
    setTimeout(function() { location.reload(); }, msToMidnight + 1000);
  </script>
</body>
</html>
