<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Trackly</title>
  <link rel="stylesheet" href="/static/design-system.css">
  <style>
    #tree-hero {
      position: relative; width: 100vw; height: 55vh; min-height: 340px;
      left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;
      background: linear-gradient(180deg, #f0fdf4 0%, #fff 100%);
      overflow: hidden;
    }
    #tree-canvas { width: 100%; height: 100%; }
    #tree-canvas canvas { display: block; width: 100%; height: 100%; }
    #tree-stats {
      position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 24px; z-index: 2;
    }
    #tree-stats .stat {
      text-align: center; min-width: 52px;
      background: rgba(255,255,255,.85); backdrop-filter: blur(8px);
      padding: 8px 14px; border-radius: 12px;
    }
    #tree-stats .num { font-size: 1.3rem; font-weight: 700; line-height: 1.2; }
    #tree-stats .lbl { font-size: .7rem; color: var(--text-2); }
    #tree-status {
      position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
      font-size: .8rem; font-weight: 600; z-index: 2;
      background: rgba(255,255,255,.8); padding: 4px 14px; border-radius: 999px;
    }
    .task-list { padding: var(--s-3) var(--s-4); }
    .task-row {
      display: flex; align-items: center; gap: var(--s-3);
      padding: var(--s-3) 0;
    }
    .task-row + .task-row { border-top: 1px solid var(--border); }
    .task-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .task-dot.high { background: var(--brand); }
    .task-dot.medium { background: var(--amber); }
    .task-dot.low { background: var(--red); }
    .task-info { flex: 1; min-width: 0; }
    .task-info .name { font-weight: 600; font-size: var(--fs-sm); }
    .task-info .meta { font-size: var(--fs-xs); color: var(--text-3); }
    .task-pct { font-weight: 700; font-size: var(--fs-sm); flex-shrink: 0; }
  </style>
</head>
<body>
  <div class="app-shell" style="padding:0;max-width:100%;">

    <!-- Nav at top -->
    <nav class="nav-pills" style="margin:var(--s-3) var(--s-4);">
      <a class="nav-pill active" href="/dashboard">今日</a>
      <a class="nav-pill" href="/dashboard/weekly">周报</a>
      <a class="nav-pill" href="/dashboard/calendar">日历</a>
      <a class="nav-pill" href="/dashboard/plans">计划</a>
      <a class="nav-pill" href="/dashboard/apps">App</a>
      <a class="nav-pill" href="/dashboard/notify">推送</a>
      <a class="nav-pill" href="/dashboard/settings">设置</a>
    </nav>

    <!-- Tree hero -->
    <div id="tree-hero">
      <div id="tree-status"><%= it.date %></div>
      <div id="tree-canvas"></div>
      <div id="tree-stats">
        <div class="stat"><span class="num" id="grown-count" style="color:var(--brand);">-</span><div class="lbl">养大</div></div>
        <div class="stat"><span class="num" id="alive-count" style="color:var(--amber);">-</span><div class="lbl">成活</div></div>
        <div class="stat"><span class="num" id="dead-count" style="color:var(--text-3);">-</span><div class="lbl">枯萎</div></div>
      </div>
    </div>

    <!-- Task list -->
    <div class="task-list">
      <% var doneCount = 0; it.plans.forEach(function(p){ if(p.progress>=75) doneCount++; }); %>
      <% if (it.plans.length > 0) { %>
        <% it.plans.forEach(function(plan) { %>
        <% const cls = plan.progress >= 75 ? 'high' : plan.progress >= 40 ? 'medium' : 'low'; %>
        <div class="task-row">
          <div class="task-dot <%= cls %>"></div>
          <div class="task-info">
            <div class="name"><%= plan.title %></div>
            <div class="meta"><%= plan.startTime %>-<%= plan.endTime %><% if (plan.appName) { %> · <%= plan.appName %><% } %></div>
          </div>
          <div class="task-pct" style="color:var(--<%= cls === 'high' ? 'brand' : cls === 'medium' ? 'amber' : 'red' %>);"><%= plan.progress %>%</div>
        </div>
        <% }) %>
      <% } else { %>
        <div style="text-align:center;padding:var(--s-5);color:var(--text-3);">
          <div style="font-size:2rem;margin-bottom:var(--s-2);">🌱</div>
          <div style="font-size:var(--fs-sm);">今天还没有学习计划</div>
        </div>
      <% } %>
    </div>

  </div>

  <script src="/static/tree.min.js"></script>
  <script>
    (function() {
      var doneCount = 0;
      <% it.plans.forEach(function(p){ if(p.progress>=75) doneCount++; }); %>
      var depth = Math.min(12, 3 + doneCount);
      var isDead = doneCount === 0 && <%= it.plans.length %> > 0;
      new TreePlugin({
        container: document.getElementById("tree-canvas"),
        depth: depth,
        growthSpeed: isDead ? 0 : 300,
        treeScale: isDead ? 0.25 : 1,
        seed: <%= it.date ? it.date.replace(/-/g, '') : '20260515' %>,
        gradientStart: isDead ? "#d4d4d4" : "#8B4513",
        gradientEnd: isDead ? "#a3a3a3" : "#228B22",
      });
    })();
    (function() {
      var uid = new URLSearchParams(location.search).get("userId") || "stu-1";
      fetch("/api/v1/dashboard/weekly?userId=" + uid)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var grown = 0, alive = 0, dead = 0;
          if (data.days) {
            data.days.forEach(function(d) {
              if (d.totalSessions >= 3) grown++;
              else if (d.totalSessions >= 1) alive++;
              else if (d.totalPlanned > 0) dead++;
            });
          }
          document.getElementById("grown-count").textContent = grown || "0";
          document.getElementById("alive-count").textContent = alive || "0";
          document.getElementById("dead-count").textContent = dead || "0";
        });
    })();
  </script>
</body>
</html>
