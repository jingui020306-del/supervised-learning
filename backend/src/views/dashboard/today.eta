<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <title>学习监督 · 仪表盘</title>
  <link rel="stylesheet" href="/dashboard/partials/design-system.css">
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <span></span>
      <h1>学习监督</h1>
      <span style="font-size:var(--text-sm);color:var(--text-muted);"><%= it.date %></span>
    </header>

    <nav class="nav-pills">
      <a class="nav-pill active" href="/dashboard">今日</a>
      <a class="nav-pill" href="/dashboard/weekly">周报</a>
      <a class="nav-pill" href="/dashboard/plans">计划</a>
      <a class="nav-pill" href="/dashboard/apps">App</a>
      <a class="nav-pill" href="/dashboard/alerts">告警</a>
      <a class="nav-pill" href="/dashboard/notify">通知</a>
    </nav>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-label">计划学习</div>
        <div class="stat-value"><%= it.summary.totalPlanned %> 分钟</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">实际学习</div>
        <div class="stat-value <%= it.summary.completionRate >= 90 ? 'good' : it.summary.completionRate >= 50 ? 'warn' : 'bad' %>"><%= it.summary.totalActual %> 分钟</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">完成率</div>
        <div class="stat-value <%= it.summary.completionRate >= 90 ? 'good' : it.summary.completionRate >= 50 ? 'warn' : 'bad' %>"><%= it.summary.completionRate %>%</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">今日计划</div>
        <div class="stat-value"><%= it.plans.length %> 项</div>
      </div>
    </div>

    <% if (it.plans.length === 0) { %>
      <div class="empty-state">
        <div class="icon">📋</div>
        <p>今天还没有学习计划</p>
        <p style="font-size:var(--text-xs);margin-top:4px;">在 Super Productivity 中添加任务，或在此创建计划</p>
      </div>
    <% } %>

    <% it.plans.forEach(function(plan, i) { %>
      <% const colorClass = plan.progress >= 90 ? 'high' : plan.progress >= 50 ? 'medium' : 'low'; %>
      <div class="glass-card <%= plan.progress < 50 ? 'glow' : '' %> animate-in" style="animation-delay:<%= i * 60 %>ms;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
          <div>
            <div style="font-weight:600;font-size:var(--text-base);"><%= plan.title %></div>
            <div style="font-size:var(--text-xs);color:var(--text-muted);margin-top:4px;">
              ⏱ <%= plan.startTime %> - <%= plan.endTime %>
              <% if (plan.appName) { %> · <%= plan.appName %><% } %>
            </div>
          </div>
          <span class="badge <%= plan.progress >= 90 ? 'badge-success' : plan.progress >= 50 ? 'badge-warning' : 'badge-danger' %>"><%= plan.progress %>%</span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill <%= colorClass %>" style="width:<%= Math.min(plan.progress, 100) %>%"></div>
        </div>
        <div class="progress-label">
          <span>已完成 <%= plan.actualMin %> 分钟</span>
          <span>目标 <%= plan.plannedMin %> 分钟</span>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="toast" id="toast"></div>
  <script>
    // Auto-refresh every 30s
    setInterval(() => location.reload(), 30000);
    function showToast(msg) {
      const t = document.getElementById("toast");
      t.textContent = msg; t.classList.add("show");
      setTimeout(() => t.classList.remove("show"), 2200);
    }
  </script>
</body>
</html>
