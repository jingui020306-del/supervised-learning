<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>日历 · Trackly</title>
  <link rel="stylesheet" href="/static/design-system.css">
  <style>
    .ical-input { margin: 0 var(--s-4) var(--s-4); }
    .day-block { margin: 0 var(--s-4) var(--s-3); }
    .day-block-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: var(--s-2) var(--s-3); border-radius: var(--r) var(--r) 0 0;
      font-weight: 600; font-size: var(--fs-sm);
    }
    .day-block-body {
      background: var(--surface); border: 1px solid var(--border); border-top: 0;
      border-radius: 0 0 var(--r) var(--r); min-height: 44px; padding: var(--s-1);
      transition: background .15s;
    }
    .day-block-body.drag-over { background: var(--brand-lt); }
    .event-row {
      display: flex; align-items: center; gap: var(--s-2); padding: 4px var(--s-2);
      font-size: var(--fs-xs);
    }
    .event-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .event-dot.plan { background: var(--brand); }
    .event-dot.busy { background: var(--amber); }
    .event-dot.free { background: #d1d5db; border: 1px dashed var(--text-3); }
    .plan-chip {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 4px 10px; margin: 2px;
      background: var(--brand-lt); border: 1px solid var(--brand);
      border-radius: var(--r-full); font-size: var(--fs-xs); cursor: grab; user-select: none;
    }
    .plan-chip:active { cursor: grabbing; }
    .plan-chip.dragging { opacity: .4; }
    .empty-hint { text-align: center; color: var(--text-3); font-size: var(--fs-xs); padding: var(--s-3); }
    .pool { display: flex; flex-wrap: wrap; gap: 4px; padding: var(--s-2) var(--s-4); margin-bottom: var(--s-4); }
    .pool-title { font-size: var(--fs-xs); color: var(--text-2); padding: 0 var(--s-4); margin-bottom: var(--s-1); }
    .tip { font-size: var(--fs-xs); color: var(--text-3); padding: var(--s-1) var(--s-4); }
  </style>
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <a href="/dashboard">← 返回</a>
      <h1>日历</h1>
      <span></span>
    </header>

    <nav class="nav-pills" style="margin:var(--s-3) var(--s-4);">
      <a class="nav-pill" href="/dashboard">今日</a>
      <a class="nav-pill" href="/dashboard/weekly">周报</a>
      <a class="nav-pill active" href="/dashboard/calendar">日历</a>
      <a class="nav-pill" href="/dashboard/plans">计划</a>
      <a class="nav-pill" href="/dashboard/apps">App</a>
      <a class="nav-pill" href="/dashboard/notify">推送</a>
      <a class="nav-pill" href="/dashboard/settings">设置</a>
    </nav>

    <!-- iCal URL input -->
    <div class="ical-input">
      <div style="font-weight:600;margin-bottom:6px;font-size:var(--fs-sm);">接入自带日历</div>
      <div style="display:flex;gap:var(--s-2);">
        <input class="input" id="ical-url" placeholder="粘贴日历 iCal 链接..." style="font-size:var(--fs-sm);flex:1;">
        <button class="btn btn-primary btn-sm" onclick="loadICal()">拉取</button>
      </div>
      <div class="tip" id="ical-tip" style="display:none;margin-top:4px;"></div>
      <div style="font-size:var(--fs-xs);color:var(--text-3);margin-top:4px;">
        iPhone: 日历App → 底部"日历" → 点 ⓘ → 公开日历 → 拷贝链接<br>
        Google: 设置 → 我的日历 → 整合日历 → iCal 格式秘密地址
      </div>
    </div>

    <!-- Unscheduled plans pool -->
    <div class="pool-title">待安排 — 拖到下面的星期里</div>
    <div class="pool" id="task-pool"></div>

    <!-- Week blocks -->
    <div id="week-blocks"></div>

    <div style="text-align:center;padding:var(--s-4);">
      <button class="btn btn-primary" onclick="saveAll()">保存排程</button>
    </div>
    <div class="toast" id="toast"></div>
  </div>

  <script>
    var UID = new URLSearchParams(location.search).get("userId") || "student-1";
    var DOW = ["日","一","二","三","四","五","六"];
    var plans = [];
    var icalEvents = {}; // { dayOfWeek: [events] }
    var dragIdx = -1;
    var icalUrl = localStorage.getItem("trackly_ical_url") || "";

    // Build week dates
    var now = new Date();
    var weekStart = new Date(now); weekStart.setDate(now.getDate() - now.getDay());
    var weekDates = [];
    for (var i = 0; i < 7; i++) {
      var d = new Date(weekStart); d.setDate(weekStart.getDate() + i);
      weekDates.push(d.toISOString().slice(0, 10));
    }

    if (icalUrl) {
      document.getElementById("ical-url").value = icalUrl;
      loadICal();
    }

    function loadICal() {
      var url = document.getElementById("ical-url").value.trim();
      if (!url) return;
      localStorage.setItem("trackly_ical_url", url);
      icalUrl = url;
      document.getElementById("ical-tip").style.display = "block";
      document.getElementById("ical-tip").textContent = "拉取中...";

      // Fetch for each day of the week
      var done = 0;
      for (var d = 0; d < 7; d++) {
        (function(day) {
          fetch("/api/v1/excel/calendar?icalUrl=" + encodeURIComponent(url) + "&date=" + weekDates[day])
            .then(function(r) { return r.json(); })
            .then(function(data) {
              icalEvents[day] = data.events || [];
              done++;
              if (done >= 7) {
                document.getElementById("ical-tip").textContent = "已接入 · 共 "
                  + Object.values(icalEvents).reduce(function(s, e) { return s + e.length; }, 0) + " 个日历事件";
                render();
              }
            }).catch(function() {
              done++;
              if (done >= 7) render();
            });
        })(d);
      }
    }

    function load() {
      fetch("/api/v1/plans?userId=" + UID)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          plans = data || [];
          render();
        });
    }

    function render() {
      // Task pool
      var unassigned = plans.filter(function(p) { return p.dayOfWeek === undefined || p.dayOfWeek < 0; });
      var poolHtml = "";
      unassigned.forEach(function(p) {
        var idx = plans.indexOf(p);
        poolHtml += '<span class="plan-chip" draggable="true" data-idx="' + idx + '"'
          + ' ondragstart="onDragStart(event,' + idx + ')" ondragend="onDragEnd(event)">'
          + p.title + ' (' + (p.durationMin||0) + 'm)</span>';
      });
      document.getElementById("task-pool").innerHTML = poolHtml || '<span class="empty-hint">所有计划已安排</span>';

      // Day blocks
      var blocksHtml = "";
      for (var d = 0; d < 7; d++) {
        var dayPlans = plans.filter(function(p) { return p.dayOfWeek === d; });
        var dayEvents = icalEvents[d] || [];

        var rowsHtml = "";

        // Calendar events from iCal (busy)
        dayEvents.forEach(function(ev) {
          var time = ev.start ? new Date(ev.start).toLocaleTimeString("zh-CN", {hour:"2-digit",minute:"2-digit"}) : "";
          rowsHtml += '<div class="event-row">'
            + '<div class="event-dot busy"></div>'
            + '<span style="flex:1;">' + ev.title + '</span>'
            + '<span style="color:var(--text-3);">' + time + '</span></div>';
        });

        // Trackly plans
        dayPlans.forEach(function(p) {
          var idx = plans.indexOf(p);
          rowsHtml += '<div class="event-row">'
            + '<div class="event-dot plan"></div>'
            + '<span class="plan-chip" draggable="true" data-idx="' + idx + '"'
            + ' ondragstart="onDragStart(event,' + idx + ')" ondragend="onDragEnd(event)"'
            + ' style="flex:1;cursor:grab;">' + p.title + ' (' + (p.durationMin||0) + 'm)</span>'
            + '<span style="color:var(--text-3);">' + (p.startTime||"") + '</span></div>';
        });

        if (!rowsHtml) rowsHtml = '<div class="empty-hint">拖计划到这里</div>';

        var bg = d === new Date().getDay() ? "background:#f0fdf4;" : "background:var(--subtle);";
        blocksHtml += '<div class="day-block">'
          + '<div class="day-block-header" style="' + bg + '">周' + DOW[d]
          + ' <span style="font-size:var(--fs-xs);color:var(--text-3);font-weight:400;">' + weekDates[d].slice(5) + '</span>'
          + (d === new Date().getDay() ? '<span style="font-size:var(--fs-xs);color:var(--brand);">今天</span>' : '')
          + '</div>'
          + '<div class="day-block-body" data-day="' + d + '"'
          + ' ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event,' + d + ')">'
          + rowsHtml + '</div></div>';
      }
      document.getElementById("week-blocks").innerHTML = blocksHtml;
    }

    function onDragStart(e, idx) { dragIdx = idx; e.target.classList.add("dragging"); }
    function onDragEnd(e) { e.target.classList.remove("dragging"); dragIdx = -1;
      document.querySelectorAll(".drag-over").forEach(function(el) { el.classList.remove("drag-over"); });
    }
    function onDragOver(e) { e.preventDefault(); e.target.closest(".day-block-body")?.classList.add("drag-over"); }
    function onDragLeave(e) { e.target.closest(".day-block-body")?.classList.remove("drag-over"); }
    function onDrop(e, day) {
      e.preventDefault(); e.target.closest(".day-block-body")?.classList.remove("drag-over");
      if (dragIdx < 0 || dragIdx >= plans.length) return;
      plans[dragIdx].dayOfWeek = day;
      render();
    }

    function saveAll() {
      var changed = plans.filter(function(p) { return p.dayOfWeek !== undefined && p.dayOfWeek >= 0; });
      var saved = 0;
      function next(i) {
        if (i >= changed.length) {
          toast("已保存 " + saved + " 项");
          return;
        }
        var p = changed[i];
        fetch("/api/v1/plans/" + p.id, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ dayOfWeek: p.dayOfWeek }),
        }).then(function() { saved++; next(i + 1); }).catch(function() { next(i + 1); });
      }
      next(0);
    }

    function toast(msg) {
      var t = document.getElementById("toast");
      t.textContent = msg; t.classList.add("show");
      setTimeout(function() { t.classList.remove("show"); }, 2000);
    }

    load();
  </script>
</body>
</html>
