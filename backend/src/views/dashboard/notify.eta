<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>监督推送 · Trackly</title>
  <link rel="stylesheet" href="/static/design-system.css">
  <style>
    .push-card { border-left: 3px solid var(--brand); }
    .push-card.feishu { border-left-color: #3b82f6; }
    .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; }
    .toggle-row + .toggle-row { border-top: 1px solid var(--border); }
  </style>
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <a href="/dashboard">← 返回</a>
      <h1>监督推送</h1>
      <span></span>
    </header>

    <nav class="nav-pills">
      <a class="nav-pill" href="/dashboard">今日</a>
      <a class="nav-pill" href="/dashboard/weekly">周报</a>
      <a class="nav-pill" href="/dashboard/calendar">日历</a>
      <a class="nav-pill" href="/dashboard/plans">计划</a>
      <a class="nav-pill" href="/dashboard/apps">App</a>
      <a class="nav-pill" href="/dashboard/settings">设置</a>
    </nav>

    <!-- 15-min supervisor push -->
    <div class="card push-card">
      <div style="font-weight:600;margin-bottom:4px;">15 分钟监督推送</div>
      <div style="font-size:var(--fs-xs);color:var(--text-3);margin-bottom:12px;">
        计划结束后 15 分钟仍未完成 → 自动推送通知给监督者
      </div>

      <div class="toggle-row">
        <span style="font-size:var(--fs-sm);">微信推送 (Server酱)</span>
        <label class="toggle">
          <input type="checkbox" id="ch-wechat" checked onchange="save()">
          <span class="toggle-track"></span><span class="toggle-thumb"></span>
        </label>
      </div>

      <div class="toggle-row">
        <span style="font-size:var(--fs-sm);">飞书机器人</span>
        <label class="toggle">
          <input type="checkbox" id="ch-feishu" onchange="save()">
          <span class="toggle-track"></span><span class="toggle-thumb"></span>
        </label>
      </div>
    </div>

    <!-- Push message template -->
    <div class="card">
      <div style="font-weight:600;margin-bottom:8px;">推送消息内容</div>
      <textarea class="textarea" id="push-msg" onchange="save()">{student} 的学习任务「{planTitle}」未完成
计划 {planned} 分钟，实际完成 {actual} 分钟 ({progress}%)
—— Trackly 监督系统</textarea>
      <div style="font-size:var(--fs-xs);color:var(--text-3);margin-top:4px;">
        变量: <code>{student}</code> <code>{planTitle}</code> <code>{planned}</code> <code>{actual}</code> <code>{progress}</code> <code>{time}</code>
      </div>
    </div>

    <!-- WeChat share hint -->
    <div class="card" style="border-left:3px solid #f59e0b;">
      <div style="font-weight:600;margin-bottom:4px;">分享到微信</div>
      <div style="font-size:var(--fs-xs);color:var(--text-2);">
        收到推送后，可在微信中长按消息 → 转发给联系人，或截图分享到朋友圈。<br>
        微信接口限制，朋友圈暂不支持 API 直发。
      </div>
    </div>

    <div class="card">
      <div style="font-weight:600;margin-bottom:8px;">监督者 Server酱 Key</div>
      <input class="input" id="serverchan-key" placeholder="SCT123456..." onchange="save()" style="font-size:var(--fs-sm);">
      <div style="font-size:var(--fs-xs);color:var(--text-3);margin-top:4px;">
        获取 Key: <a href="https://sct.ftqq.com/" target="_blank">sct.ftqq.com</a>
      </div>
    </div>

    <div class="card">
      <div style="font-weight:600;margin-bottom:8px;">飞书 Webhook 地址</div>
      <input class="input" id="feishu-url" placeholder="https://open.feishu.cn/open-apis/bot/v2/hook/..." onchange="save()" style="font-size:var(--fs-sm);">
      <div style="font-size:var(--fs-xs);color:var(--text-3);margin-top:4px;">
        飞书群 → 设置 → 群机器人 → 添加 → 复制 Webhook
      </div>
    </div>

    <div class="toast" id="toast"></div>
  </div>

  <script>
    var KEY = "sl_notify_cfg";
    var cfg = JSON.parse(localStorage.getItem(KEY) || "{}");

    function load() {
      document.getElementById("ch-wechat").checked = cfg.wechat !== false;
      document.getElementById("ch-feishu").checked = cfg.feishu === true;
      document.getElementById("push-msg").value = cfg.msg || document.getElementById("push-msg").textContent;
      document.getElementById("serverchan-key").value = cfg.serverchan || "";
      document.getElementById("feishu-url").value = cfg.feishuUrl || "";
    }

    function save() {
      cfg.wechat = document.getElementById("ch-wechat").checked;
      cfg.feishu = document.getElementById("ch-feishu").checked;
      cfg.msg = document.getElementById("push-msg").value;
      cfg.serverchan = document.getElementById("serverchan-key").value;
      cfg.feishuUrl = document.getElementById("feishu-url").value;
      localStorage.setItem(KEY, JSON.stringify(cfg));
      var t = document.getElementById("toast");
      t.textContent = "已保存"; t.classList.add("show");
      setTimeout(function() { t.classList.remove("show"); }, 1500);
    }

    load();
  </script>
</body>
</html>
