<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>推送设置 · Trackly</title>
  <link rel="stylesheet" href="/static/design-system.css">
  <style>
    .push-card { border-left: 3px solid var(--brand); }
    .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; }
    .toggle-row + .toggle-row { border-top: 1px solid var(--border); }
    .step { display: flex; gap: 8px; margin: 8px 0; font-size: var(--fs-sm); }
    .step .num { width: 22px; height: 22px; border-radius: 50%; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-size: var(--fs-xs); font-weight: 700; flex-shrink: 0; }
  </style>
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <a href="/dashboard">← 返回</a>
      <h1>推送设置</h1>
      <span></span>
    </header>

    <nav class="nav-pills">
      <a class="nav-pill" href="/dashboard">今日</a>
      <a class="nav-pill" href="/dashboard/weekly">周报</a>
      <a class="nav-pill" href="/dashboard/calendar">日历</a>
      <a class="nav-pill" href="/dashboard/plans">计划</a>
      <a class="nav-pill" href="/dashboard/apps">App</a>
      <a class="nav-pill" href="/dashboard/settings">设置</a>
    </nav>

    <!-- ── 学生自己授权 ── -->
    <div class="section-title">学生自我监督</div>

    <div class="card push-card">
      <div style="font-weight:600;margin-bottom:4px;">绑定我的微信</div>
      <div style="font-size:var(--fs-xs);color:var(--text-2);margin-bottom:12px;line-height:1.6;">
        任务未完成时，通过你授权的方式发消息。消息以你的身份发出，朋友能看到。
      </div>

      <div class="step"><span class="num">1</span> 打开 <a href="https://sct.ftqq.com/" target="_blank">sct.ftqq.com</a>，微信扫码登录</div>
      <div class="step"><span class="num">2</span> 复制你的 SendKey</div>
      <div class="step"><span class="num">3</span> 粘贴到下方，关注 Server酱 公众号</div>

      <input class="input" id="my-sendkey" placeholder="SCT123456..." onchange="save()" style="margin-top:8px;font-size:var(--fs-sm);">
    </div>

    <!-- ── 微信推送开关 ── -->
    <div class="card push-card">
      <div style="font-weight:600;margin-bottom:4px;">未完成时推送给我自己</div>
      <div style="font-size:var(--fs-xs);color:var(--text-2);margin-bottom:8px;">
        计划结束后 15 分钟仍未完成 → 微信收到消息
      </div>

      <div class="toggle-row">
        <span>Bark (iPad 推送)</span>
        <label class="toggle">
          <input type="checkbox" id="bark-enabled" checked onchange="save()">
          <span class="toggle-track"></span><span class="toggle-thumb"></span>
        </label>
      </div>

      <div class="toggle-row">
        <span>微信推送 (我自己收到)</span>
        <label class="toggle">
          <input type="checkbox" id="self-wechat" checked onchange="save()">
          <span class="toggle-track"></span><span class="toggle-thumb"></span>
        </label>
      </div>
    </div>

    <!-- ── 忏悔消息模板 ── -->
    <div class="card">
      <div style="font-weight:600;margin-bottom:4px;">忏悔消息</div>
      <div style="font-size:var(--fs-xs);color:var(--text-2);margin-bottom:8px;">
        收到后可以转发给朋友，或截图发朋友圈。以你的名义公开进度。
      </div>
      <textarea class="textarea" id="confession-msg" onchange="save()">我今天的学习任务「{planTitle}」没有按时完成
计划 {planned} 分钟，实际只完成了 {actual} 分钟
明天一定补上</textarea>
      <div style="font-size:var(--fs-xs);color:var(--text-3);margin-top:4px;">
        变量: <code>{planTitle}</code> <code>{planned}</code> <code>{actual}</code> <code>{progress}</code>
      </div>
    </div>

    <!-- ── 指定朋友 ── -->
    <div class="card">
      <div style="font-weight:600;margin-bottom:4px;">抄送给指定朋友</div>
      <div style="font-size:var(--fs-xs);color:var(--text-2);margin-bottom:8px;">
        朋友的 Server酱 SendKey。未完成时他们也收到通知。多个用逗号分隔。
      </div>
      <input class="input" id="friend-keys" placeholder="朋友的 SendKey (可选, 逗号分隔)" onchange="save()" style="font-size:var(--fs-sm);">
      <div style="font-size:var(--fs-xs);color:var(--text-3);margin-top:4px;">
        让朋友也去 sct.ftqq.com 扫码获取 SendKey 发给你
      </div>
    </div>

    <!-- ── 监督者(家长) ── -->
    <div class="section-title">监督者通知</div>
    <div class="card">
      <div style="font-weight:600;margin-bottom:4px;">家长/老师接收通知</div>
      <div style="font-size:var(--fs-xs);color:var(--text-2);margin-bottom:8px;">
        15 分钟未完成 → 自动推送给你的监督者
      </div>

      <div class="toggle-row">
        <span>微信通知监督者</span>
        <label class="toggle">
          <input type="checkbox" id="super-wechat" onchange="save()">
          <span class="toggle-track"></span><span class="toggle-thumb"></span>
        </label>
      </div>

      <div class="toggle-row">
        <span>飞书通知监督者</span>
        <label class="toggle">
          <input type="checkbox" id="super-feishu" onchange="save()">
          <span class="toggle-track"></span><span class="toggle-thumb"></span>
        </label>
      </div>

      <input class="input" id="super-keys" placeholder="监督者 Server酱 Key 或飞书 Webhook" onchange="save()" style="margin-top:8px;font-size:var(--fs-sm);">
    </div>

    <div class="toast" id="toast"></div>
  </div>

  <script>
    var KEY = "sl_notify_cfg";
    var cfg = JSON.parse(localStorage.getItem(KEY) || "{}");

    function load() {
      document.getElementById("my-sendkey").value = cfg.mySendkey || "";
      document.getElementById("bark-enabled").checked = cfg.bark !== false;
      document.getElementById("self-wechat").checked = cfg.selfWechat !== false;
      document.getElementById("confession-msg").value = cfg.confession || document.getElementById("confession-msg").textContent;
      document.getElementById("friend-keys").value = cfg.friendKeys || "";
      document.getElementById("super-wechat").checked = cfg.superWechat === true;
      document.getElementById("super-feishu").checked = cfg.superFeishu === true;
      document.getElementById("super-keys").value = cfg.superKeys || "";
    }

    function save() {
      cfg.mySendkey = document.getElementById("my-sendkey").value;
      cfg.bark = document.getElementById("bark-enabled").checked;
      cfg.selfWechat = document.getElementById("self-wechat").checked;
      cfg.confession = document.getElementById("confession-msg").value;
      cfg.friendKeys = document.getElementById("friend-keys").value;
      cfg.superWechat = document.getElementById("super-wechat").checked;
      cfg.superFeishu = document.getElementById("super-feishu").checked;
      cfg.superKeys = document.getElementById("super-keys").value;
      localStorage.setItem(KEY, JSON.stringify(cfg));
      var t = document.getElementById("toast");
      t.textContent = "已保存"; t.classList.add("show");
      setTimeout(function() { t.classList.remove("show"); }, 1500);
    }

    load();
  </script>
</body>
</html>
