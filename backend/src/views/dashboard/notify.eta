<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>通知设置 · 学习监督</title>
  <link rel="stylesheet" href="/static/design-system.css">
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <a href="/dashboard">← 返回</a>
      <h1>通知设置</h1>
      <span></span>
    </header>

    <nav class="nav-pills">
      <a class="nav-pill" href="/dashboard">今日</a>
      <a class="nav-pill" href="/dashboard/weekly">周报</a>
      <a class="nav-pill" href="/dashboard/calendar">日历</a>
      <a class="nav-pill" href="/dashboard/plans">计划</a>
      <a class="nav-pill" href="/dashboard/apps">App</a>
      <a class="nav-pill" href="/dashboard/settings">设置</a>
    

    <!-- Reminder template -->
    <div class="section-title">提醒消息模板</div>

    <div class="card">
      <div style="font-weight:600;margin-bottom:8px;">进度落后提醒（学生端）</div>
      <textarea class="textarea" id="tpl-student-behind" onchange="markChanged()">
 {planTitle} 进度落后
当前完成 {progress}%，还差 {deficit} 分钟
打开 App 继续学习吧！</textarea>
      <div style="font-size:var(--fs-xs);color:var(--text-3);margin-top:4px;">
        可用变量：<code>{planTitle}</code> <code>{progress}</code> <code>{deficit}</code> <code>{planned}</code> <code>{actual}</code>
      </div>
    </div>

    <div class="card">
      <div style="font-weight:600;margin-bottom:8px;">进度落后提醒（监督者端）</div>
      <textarea class="textarea" id="tpl-supervisor-behind" onchange="markChanged()">
 学习监督提醒
{planTitle} 进度落后，当前完成 {progress}%
计划 {planned} 分钟，实际 {actual} 分钟，差额 {deficit} 分钟</textarea>
    </div>

    <div class="card">
      <div style="font-weight:600;margin-bottom:8px;">任务未完成提醒</div>
      <textarea class="textarea" id="tpl-incomplete" onchange="markChanged()">
 {planTitle} 未完成！
计划时间已过，仅完成 {progress}%
计划 {planned} 分钟，实际 {actual} 分钟</textarea>
    </div>

    <!-- Notification recipients -->
    <div class="section-title">通知接收人</div>
    <div class="card">
      <div style="font-weight:600;margin-bottom:8px;">监督者通知渠道</div>
      <div class="tag-row" id="channel-tags">
        <span class="tag selected" data-channel="wechat" onclick="toggleChannel('wechat')"> 微信</span>
        <span class="tag" data-channel="feishu" onclick="toggleChannel('feishu')"> 飞书</span>
      </div>
    </div>

    <div class="card">
      <div style="font-weight:600;margin-bottom:8px;">添加联系人</div>
      <div class="input-group" style="margin-bottom:8px;">
        <input class="input" type="text" id="new-contact-name" placeholder="联系人名称...">
        <input class="input" type="text" id="new-contact-phone" placeholder="手机号 (可选)">
        <button class="btn btn-primary btn-sm" onclick="addContact()" style="flex-shrink:0;">+</button>
      </div>
      <div id="contact-list" style="font-size:var(--fs-sm);color:var(--text-3);">加载中...</div>
    </div>

    <button class="btn btn-primary btn-full" onclick="saveAll()" id="save-btn" style="margin-top:16px;">保存设置</button>
    <div class="toast" id="toast"></div>
  </div>

  <script>
    const USER_ID = new URLSearchParams(location.search).get("userId") || "student-1";
    let contacts = JSON.parse(localStorage.getItem("sl_contacts") || "[]");
    let templates = JSON.parse(localStorage.getItem("sl_templates") || "{}");
    let channels = JSON.parse(localStorage.getItem("sl_channels") || '["wechat"]');
    let dirty = false;

    function init() {
      // Load templates
      const tpls = {
        "tpl-student-behind": templates["student-behind"] || "",
        "tpl-supervisor-behind": templates["supervisor-behind"] || "",
        "tpl-incomplete": templates["incomplete"] || "",
      };
      for (const [id, val] of Object.entries(tpls)) {
        if (val) document.getElementById(id).value = val;
      }
      // Load channels
      document.querySelectorAll("#channel-tags .tag").forEach(t => {
        t.classList.toggle("selected", channels.includes(t.dataset.channel));
      });
      renderContacts();
    }

    function toggleChannel(ch) {
      if (channels.includes(ch)) channels = channels.filter(c => c !== ch);
      else channels.push(ch);
      localStorage.setItem("sl_channels", JSON.stringify(channels));
      document.querySelectorAll("#channel-tags .tag").forEach(t => {
        t.classList.toggle("selected", channels.includes(t.dataset.channel));
      });
      dirty = true;
    }

    function addContact() {
      const name = document.getElementById("new-contact-name").value.trim();
      const phone = document.getElementById("new-contact-phone").value.trim();
      if (!name) return toast("请输入联系人名称");
      contacts.push({ name, phone: phone || "", id: Date.now().toString() });
      localStorage.setItem("sl_contacts", JSON.stringify(contacts));
      document.getElementById("new-contact-name").value = "";
      document.getElementById("new-contact-phone").value = "";
      renderContacts();
      toast(`已添加联系人 "${name}"`);
      dirty = true;
    }

    function removeContact(id) {
      contacts = contacts.filter(c => c.id !== id);
      localStorage.setItem("sl_contacts", JSON.stringify(contacts));
      renderContacts();
      dirty = true;
    }

    function renderContacts() {
      const html = contacts.map(c => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);">
          <div>
            <span style="font-weight:500;">${c.name}</span>
            ${c.phone ? `<span style="color:var(--text-3);margin-left:8px;">${c.phone}</span>` : ""}
          </div>
          <button class="btn btn-danger btn-sm" onclick="removeContact('${c.id}')" style="padding:2px 8px;">✕</button>
        </div>
      `).join("");
      document.getElementById("contact-list").innerHTML = html || "尚未添加联系人";
    }

    function markChanged() { dirty = true; }

    async function saveAll() {
      // Save templates
      templates["student-behind"] = document.getElementById("tpl-student-behind").value;
      templates["supervisor-behind"] = document.getElementById("tpl-supervisor-behind").value;
      templates["incomplete"] = document.getElementById("tpl-incomplete").value;
      localStorage.setItem("sl_templates", JSON.stringify(templates));

      const btn = document.getElementById("save-btn");
      btn.disabled = true; btn.textContent = "保存中...";
      try {
        await fetch("/api/v1/sync/sp-hook", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            userId: USER_ID,
            settings: { contacts, channels, templates },
          }),
        });
        dirty = false;
        btn.textContent = "已保存 ";
        setTimeout(() => { btn.textContent = "保存设置"; btn.disabled = false; }, 1500);
        toast("设置已保存");
      } catch (e) {
        btn.disabled = false; btn.textContent = "保存设置";
        toast("网络错误，设置已保存到本地");
      }
    }

    function toast(msg) {
      const t = document.getElementById("toast");
      t.textContent = msg; t.classList.add("show");
      setTimeout(() => t.classList.remove("show"), 2000);
    }

    init();
  </script>
</body>
</html>
