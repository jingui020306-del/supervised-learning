<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>App 管理 · 学习监督</title>
  <link rel="stylesheet" href="/static/design-system.css">
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <a href="/dashboard">← 返回</a>
      <h1>App 管理</h1>
      <span></span>
    </header>

    <nav class="nav-pills" style="margin:var(--s-3) var(--s-4);">
      <a class="nav-pill" href="/dashboard">今日</a>
      <a class="nav-pill" href="/dashboard/weekly">周报</a>
      <a class="nav-pill" href="/dashboard/calendar">日历</a>
      <a class="nav-pill" href="/dashboard/plans">计划</a>
      <a class="nav-pill active" href="/dashboard/apps">App</a>
      <a class="nav-pill" href="/dashboard/notify">推送</a>
      <a class="nav-pill" href="/dashboard/settings">设置</a>
    </nav>

    <div class="section-title" style="padding:var(--s-3) var(--s-4) var(--s-1);">添加 App</div>
    <div style="display:flex;gap:var(--s-2);padding:0 var(--s-4);margin-bottom:var(--s-4);">
      <input class="input" type="text" id="new-app-name" placeholder="App 名称..." style="flex:1;font-size:var(--fs-sm);">
      <button class="btn btn-primary btn-sm" onclick="addApp()">+ 添加</button>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <span style="font-size:var(--fs-sm);color:var(--text-3);">
        已授权 <strong id="granted-count" style="color:var(--text);">0</strong> / <span id="total-count">0</span>
      </span>
      <input class="input" type="text" id="search" placeholder="搜索..." style="width:160px;padding:6px 12px;font-size:var(--fs-sm);" oninput="renderList()">
    </div>

    <div id="app-list"><p class="empty-state">加载中...</p></div>

    <button class="btn btn-primary btn-full" onclick="saveAll()" id="save-btn" disabled style="margin-top:12px;">保存更改</button>

    <div class="toast" id="toast"></div>
  </div>

  <script>
    const USER_ID = new URLSearchParams(location.search).get("userId") || "student-1";
    let apps = [];
    let changed = new Set();

    async function load() {
      try {
        const res = await fetch(`/api/v1/apps?userId=${USER_ID}`);
        apps = await res.json();
        apps = apps.filter(function(a) { return a.id !== null && a.appName; });
        renderList();
      } catch (e) {
        document.getElementById("app-list").innerHTML = '<div class="empty-state"><p>加载失败</p></div>';
      }
    }

    function renderList() {
      document.getElementById("app-list").innerHTML = apps.map(function(app) {
        return '<div class="card' + (app.enabled ? ' active' : '') + '" style="display:flex;align-items:center;justify-content:space-between;">'
          + '<div style="display:flex;align-items:center;gap:12px;flex:1;min-width:0;">'
          + '<div style="min-width:0;"><div style="font-weight:600;font-size:var(--fs);">' + app.appName + '</div>'
          + '<div style="font-size:var(--fs-xs);color:var(--text-3);">' + (app.bundleId || '') + '</div></div></div>'
          + '<div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">'
          + '<button class="btn btn-sm" style="color:var(--red);" onclick="removeApp(\'' + app.appName + '\')">删除</button>'
          + '<label class="toggle"><input type="checkbox"' + (app.enabled ? ' checked' : '')
          + ' onchange="toggleApp(\'' + app.appName + '\',this.checked)">'
          + '<span class="toggle-track"></span><span class="toggle-thumb"></span></label></div></div>';
      }).join("") || '<div class="empty-state"><p>暂无 App</p></div>';
    }

    async function addApp() {
      var name = document.getElementById("new-app-name").value.trim();
      if (!name) return toast("请输入应用名称");
      try {
        await fetch("/api/v1/apps/" + encodeURIComponent(name), {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ userId: USER_ID, appName: name, enabled: true }),
        });
        document.getElementById("new-app-name").value = "";
        toast("已添加 " + name);
        load();
      } catch (e) { toast("添加失败"); }
    }

    async function removeApp(appName) {
      if (!confirm("确定移除 " + appName + "?")) return;
      try {
        await fetch("/api/v1/apps/" + encodeURIComponent(appName), {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ userId: USER_ID, appName: appName, enabled: false }),
        });
        apps = apps.filter(function(a) { return a.appName !== appName; });
        changed.delete(appName);
        renderList();
        toast("已移除 " + appName);
      } catch (e) { toast("操作失败"); }
    }

    function toggleApp(appName, enabled) {
      var app = apps.find(function(a) { return a.appName === appName; });
      if (app) { app.enabled = enabled; changed.add(appName); document.getElementById("save-btn").disabled = false; }
    }

    async function saveAll() {
      const btn = document.getElementById("save-btn");
      btn.disabled = true; btn.textContent = "保存中...";
      const changedPerms = apps.filter(a => changed.has(a.appName)).map(a => ({ appName: a.appName, enabled: a.enabled }));
      try {
        await fetch("/api/v1/apps/batch", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ userId: USER_ID, permissions: changedPerms }),
        });
        changed.clear();
        btn.textContent = "保存更改";
        toast("已保存 ");
      } catch (e) {
        btn.disabled = false;
        btn.textContent = "网络错误，重试";
      }
    }

    function toast(msg) {
      const t = document.getElementById("toast");
      t.textContent = msg; t.classList.add("show");
      setTimeout(() => t.classList.remove("show"), 2000);
    }

    load();
  </script>
</body>
</html>
