{
  "name": "supervised-learning-backend",
  "version": "1.0.0",
  "description": "学习监督系统后端",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/views dist/",
    "start": "node dist/index.js",
    "package": "npm run build && pkg dist/index.js --targets node22-macos-x64,node22-win-x64 --output dist/supervised-learning-backend",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.0",
    "@fastify/static": "^8.1.1",
    "@fastify/view": "^10.0.2",
    "@prisma/client": "^6.2.1",
    "eta": "^3.5.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "pkg": "^5.8.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pkg": {
    "assets": [
      "node_modules/.prisma/client/**/*",
      "node_modules/@prisma/client/**/*"
    ]
  }
}
