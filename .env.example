# 后端配置
PORT=3001
HOST=0.0.0.0
DATABASE_URL="file:./data/supervised-learning.db"

# 认证 (Base64 token, 用于 iPad Shortcuts 和 SP 插件)
API_TOKEN=change-me-to-a-random-string

# Bark 推送 (学生 iPad)
BARK_URL=https://api.day.app
BARK_DEVICE_KEY=your-bark-device-key

# Server酱 (微信通知给监督者)
SERVERCHAN_SEND_KEY=your-serverchan-send-key

# 飞书 Webhook (监督者通知)
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-hook-id

# Super Productivity
SP_URL=http://localhost:80

# ActivityWatch (可选)
AW_BASE_URL=http://localhost:5600
AW_ENABLED=false
